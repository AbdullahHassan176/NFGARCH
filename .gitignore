# R session and history
.Rhistory
.Rapp.history
.RData
.Ruserdata

# RStudio project files
.Rproj.user/
*.Rproj

# Package build and check artifacts
.Rbuildignore
/*.Rcheck/
/*.tar.gz

# Project R package library (install via setup or R)
environment/R_library/

# Python cache (if any Python usage in future)
__pycache__/
*.pyc

# Editor-specific files
.DS_Store
Thumbs.db
*.ai
_push_tmp/

# LaTeX build files (for reports or papers)
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.pdf
*.tex
