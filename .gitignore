!MDPI_Article_Template__1_/**/*.tex
!MDPI_Risks___NF_GARCH_PAPER/**/*.tex
!MSc_Mathematical_Statistics___Abdullah_Hassan___Dissertation/**/*.tex
!MSc_Mathematical_Statistics___Abdullah_Hassan___Dissertation (1)/**/*.tex


data/raw/*
!data/raw/.gitkeep

results/tables/*
!results/tables/garch_comparison.csv

# Large RDS outputs (exceed GitHub 100MB limit)
**/detailed_results.rds
